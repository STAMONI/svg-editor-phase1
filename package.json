{
  "name": "svg-editor-phase1",
  "version": "0.1.0",
  "private": true,
  "description": "Lab1 Phase 1: SVG editor CLI (TypeScript, OOP, Command pattern)",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "precli": "npm run build",
    "cli": "node dist/src/index.js",
    "test": "npm run build && node --test --test-isolation=none \"dist/test/**/*.test.js\"",
    "check:layering": "node scripts/check-layering.mjs",
    "verify": "npm run build && npm run check:layering && node --test --test-isolation=none \"dist/test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.8.0"
  },
  "keywords": [
    "svg",
    "cli",
    "command-pattern",
    "composite"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
